load("@rules_go//go:def.bzl", "go_library", "go_test")

# gazelle_dependencies(go_repository_default_config = "//:WORKSPACE.bazel")

go_library(
    name = "go",
    srcs = ["floe.go"],
    importpath = "go/go",
    visibility = ["//visibility:public"],
)

go_test(
    name = "go_test",
    # keep: This intentionally does not include the FIPS test
    srcs = ["floe_test.go"],
    data = ["//:test_kats"],
    embed = [":go"],
)

go_test(
    name = "go_test_fips",
    srcs = [
        "floe_fips_test.go",
        "floe_test.go",
    ],
    data = ["//:test_kats"],
    embed = [":go"],
    env = {
        "GODEBUG": "fips140=only",
    },
)
